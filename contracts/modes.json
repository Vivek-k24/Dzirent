{
  "version": "0.1.0-candidate.3",
  "values": ["demo", "connected"],
  "default": "demo",
  "web_mode_env": "NEXT_PUBLIC_DZIRENT_MODE",
  "api_mode_env": "DZIRENT_MODE",
  "demo": {
    "identity": "mock",
    "catalog": "msw",
    "fixtures": "fixtures/catalog/manifest.json",
