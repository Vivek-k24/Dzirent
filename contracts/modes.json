    "catalog": "fastapi-postgresql",
    "allow_mock_fallback": false,
    "protected_writes": "fail-closed",
    "refresh_interval_ms": 5000,
    "realtime_claim": "periodic refresh; no pushed synchronization"
  },
  "api_mock_identity_allowed_only": { "mode": "demo", "environment": ["local", "test"] },
