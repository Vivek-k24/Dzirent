# Phase 1A uses MSW only in explicit demo mode. No credentials needed.
NEXT_PUBLIC_DZIRENT_MODE=demo
# Connected mode uses a same-origin transport and never falls back to MSW.
# Phase 1 implementation is untested; do not enable staging/deploy before owner review.
# These are server-only settings. HTTPS is required for staging.
DZIRENT_API_UPSTREAM_URL=http://127.0.0.1:8000/api/v1
DZIRENT_WEB_ORIGIN=http://127.0.0.1:3000
