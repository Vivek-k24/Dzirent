{
  "name": "dzirent-web",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node ../../contracts/generate.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prelint": "node ../../contracts/generate.mjs --check",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types src/lib/errors.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        ".": "11.0.3",
        "@isaacs/nonrecursive-glob-match": "1.0.3"
      }
    }
  }
}
