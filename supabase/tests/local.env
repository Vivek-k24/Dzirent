TEST_USER_2_PASSWORD=local-test-password-2
TEST_USER_3_EMAIL=test3@dzirent.local
TEST_USER_3_PASSWORD=local-test-password-3
TEST_ADMIN_EMAIL=admin@dzirent.local
TEST_ADMIN_PASSWORD=local-admin-password
