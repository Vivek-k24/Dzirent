# C4: environment for `supabase functions serve` against the LOCAL backend and stripe-mock only.
# Everything in local.env, plus placeholder Stripe values that only stripe-mock (the official
# stripe/stripe-mock image, which accepts any test-looking key) and the local webhook test accept.
# They are not Stripe keys and reach nothing outside this PC's or CI's Docker. Real keys are never
# put in any file: see the runbook in pranalika/contract.md section 7.
SEND_PUSH_SECRET=local-push-secret
SCAN_LISTING_SECRET=local-scan-secret
CLEANUP_FILES_SECRET=local-cleanup-secret
VISION_URL=http://dzirent-stubs:8787
PAYMENTS_JOB_SECRET=local-payments-secret
# C5: send-email with the provider key blank (every email skipped, nothing sent).
EMAIL_JOB_SECRET=local-email-secret
EMAIL_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=sk_test_stripemock
STRIPE_PUBLISHABLE_KEY=pk_test_stripemock
STRIPE_WEBHOOK_SECRET=whsec_local_test_secret
# Through the stub server, which records each call and passes it to stripe-mock.
STRIPE_API_BASE=http://dzirent-stubs:8787/stripe
