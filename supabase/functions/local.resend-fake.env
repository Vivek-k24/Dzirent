# E1: environment for `supabase functions serve` against the LOCAL backend and the local fake Resend
# only (supabase/tests/stubs/server.mjs, /resend/emails). Everything in local.env, plus placeholder
# values only the stub accepts: they are not Resend keys and reach nothing outside this PC's or
# CI's Docker. The real key and webhook secret are Edge Function secrets on the live project only
# (runbook in pranalika/contract.md section 9); EMAIL_API_URL is never set there.
# The same three shared secrets are put in the local Vault by supabase/seed.sql.
SEND_PUSH_SECRET=local-push-secret
SCAN_LISTING_SECRET=local-scan-secret
CLEANUP_FILES_SECRET=local-cleanup-secret
# C4: the outbox's secret for stripe-deposit and stripe-refund (Vault payments_job_secret locally).
PAYMENTS_JOB_SECRET=local-payments-secret
# C4: the Stripe keys stay blank, so every payment function answers "Payments aren't available yet."
# The stripe-mock tests use supabase/functions/local.stripe-mock.env instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_JOB_SECRET=local-email-secret
# C6: the outbox's secret for didit-sync (Vault didit_job_secret locally). The Didit keys stay blank,
# so every Didit function answers "ID verification isn't available yet." The Didit stub tests use
# supabase/functions/local.didit-stub.env instead.
DIDIT_JOB_SECRET=local-didit-secret
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# Outside services are stubbed (supabase/tests/stubs/server.mjs). The local Vault sends pushes and
# photo checks to the stub directly; these keep send-push and scan-listing from reaching Google.
VISION_URL=http://dzirent-stubs:8787
# E1: the fake Resend (records each email) and the webhook test secret (tests sign their own events).
RESEND_API_KEY=local-fake-resend-key
EMAIL_API_URL=http://dzirent-stubs:8787/resend/emails
RESEND_WEBHOOK_SECRET=whsec_bG9jYWwtcmVzZW5kLXdlYmhvb2stdGVzdC1rZXktMDE=
