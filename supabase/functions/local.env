# C2: environment for `supabase functions serve` against the LOCAL backend only.
# Non-secret local values: they protect nothing outside a developer's or CI's own Docker.
# Never use these for dzirent-server; its secrets live in `supabase secrets` and Vault.
# The same three shared secrets are put in the local Vault by supabase/seed.sql.
SEND_PUSH_SECRET=local-push-secret
SCAN_LISTING_SECRET=local-scan-secret
CLEANUP_FILES_SECRET=local-cleanup-secret
# C4: the outbox's secret for stripe-deposit and stripe-refund (Vault payments_job_secret locally).
PAYMENTS_JOB_SECRET=local-payments-secret
# C4: the Stripe keys stay blank, so every payment function answers "Payments aren't available yet."
# The stripe-mock tests use supabase/functions/local.stripe-mock.env instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Outside services are stubbed (supabase/tests/stubs/server.mjs). The local Vault sends pushes and
# photo checks to the stub directly; these keep send-push and scan-listing from reaching Google.
VISION_URL=http://dzirent-stubs:8787
