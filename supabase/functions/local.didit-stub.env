# C6: environment for `supabase functions serve` against the LOCAL backend and the local Didit stub
# only (supabase/tests/stubs/server.mjs, /didit/...). Everything in local.env, plus placeholder Didit
# values that only the stub accepts: they are not Didit keys and reach nothing outside this PC's or
# CI's Docker. The real key and webhook secret are Edge Function secrets on the live project only
# (runbook in pranalika/contract.md section 10); DIDIT_API_BASE is never set there.
SEND_PUSH_SECRET=local-push-secret
SCAN_LISTING_SECRET=local-scan-secret
CLEANUP_FILES_SECRET=local-cleanup-secret
VISION_URL=http://dzirent-stubs:8787
PAYMENTS_JOB_SECRET=local-payments-secret
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_JOB_SECRET=local-email-secret
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DIDIT_JOB_SECRET=local-didit-secret
DIDIT_API_KEY=didit-stub-key
DIDIT_WEBHOOK_SECRET=local-didit-webhook-secret
# Through the stub server, which records each call and answers like Didit's API.
DIDIT_API_BASE=http://dzirent-stubs:8787/didit
