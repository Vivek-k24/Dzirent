# dzirent API environment template. Copy to services/api/.env (ignored by Git).
# Never commit real values or copy any of these into NEXT_PUBLIC_* web variables.

# Modes (contracts/modes.json). Mock identity is accepted ONLY with mode=demo and
# environment=local|test; startup refuses it everywhere else.
DZIRENT_MODE=demo
DZIRENT_ENVIRONMENT=local
DZIRENT_IDENTITY_MODE=mock

# PostgreSQL. Local Compose default shown; hosted URLs come from platform secret storage.
# postgresql:// URLs are accepted and mapped to the psycopg 3 driver.
DZIRENT_DATABASE_URL=postgresql+psycopg://dzirent:local-disposable-only@127.0.0.1:5432/dzirent_dev
DZIRENT_DB_POOL_SIZE=5
DZIRENT_DB_CONNECT_TIMEOUT_S=5
DZIRENT_DB_STATEMENT_TIMEOUT_MS=5000

# Clerk (required when DZIRENT_IDENTITY_MODE=clerk, always in connected mode).
# Issuer is the instance Frontend API URL (https). Authorized parties are the exact web origins.
DZIRENT_CLERK_ISSUER=
DZIRENT_CLERK_AUTHORIZED_PARTIES=[]
# Provide one: the instance PEM public key (networkless verification, preferred) or the secret key.
DZIRENT_CLERK_JWT_KEY=
DZIRENT_CLERK_SECRET_KEY=
# Optional: only if session tokens are customized to carry an aud claim.
DZIRENT_CLERK_AUDIENCE=

# Exact browser origins (scheme://host[:port], no wildcard or path). Deployed environments need https.
DZIRENT_CORS_ORIGINS=["http://127.0.0.1:3000"]
DZIRENT_LOG_LEVEL=INFO

# AI-QUALITY-1 local/test only: internal photo-quality service for POST /api/v1/dev/photo-quality.
# Leave empty to keep the route unmounted. Refused at startup in staging/production.
DZIRENT_PHOTO_QUALITY_URL=
DZIRENT_PHOTO_QUALITY_TIMEOUT_S=15
