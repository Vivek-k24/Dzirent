{
  "name": "dzirent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": { "node": ">=22.23.2 <23", "pnpm": "10.29.3" },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "node scripts/task.mjs web demo 3000",
    "dev:web:connected": "node scripts/task.mjs web connected 3000",
    "dev:api": "node scripts/task.mjs api demo 8000",
    "dev:api:connected": "node scripts/task.mjs api connected 8000",
    "dev:qa:web": "node scripts/task.mjs web demo 3100",
    "dev:qa:api": "node scripts/task.mjs api demo 8100",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api:sync": "node scripts/task.mjs api-sync",
    "contracts:generate": "node scripts/task.mjs contracts-generate",
    "contracts:check": "node scripts/task.mjs contracts-check",
    "fixtures:check": "node scripts/task.mjs fixtures-check",
    "lint": "eslint apps/web packages scripts",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @dzirent/web build",
    "smoke:web": "node scripts/smoke-web.mjs",
    "test:web": "pnpm --filter @dzirent/web test",
    "media:check": "node apps/web/scripts/check-media.mjs",
    "deploy:check": "node scripts/check-deployment-guards.mjs",
    "check": "node scripts/task.mjs check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "typescript": "5.9.3"
  }
}
