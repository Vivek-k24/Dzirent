{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "siteName": { "type": "string" },
    "planName": { "type": "string" },
    "location": { "type": "string", "defaultValue": "northcentralus", "allowedValues": ["northcentralus"] },
    "sourceSha": { "type": "string", "minLength": 40, "maxLength": 40 }
  },
  "variables": {
    "tags": { "project": "dzirent", "environment": "staging", "issue": "77", "source": "[parameters('sourceSha')]" }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2025-03-01",
      "name": "[parameters('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "tags": "[variables('tags')]",
      "sku": { "name": "F1", "tier": "Free", "size": "F1", "capacity": 1 },
      "properties": { "reserved": true, "perSiteScaling": false, "zoneRedundant": false }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2025-03-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "tags": "[variables('tags')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.12",
          "appCommandLine": "bash infra/runtime/start-appservice.sh",
          "alwaysOn": false,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "remoteDebuggingEnabled": false,
          "healthCheckPath": "/api/v1/health/ready",
          "appSettings": [
            { "name": "DZIRENT_MODE", "value": "connected" },
            { "name": "DZIRENT_ENVIRONMENT", "value": "staging" },
            { "name": "DZIRENT_IDENTITY_MODE", "value": "native" },
            { "name": "DZIRENT_AUTH_EMAIL_BACKEND", "value": "disabled" },
            { "name": "DZIRENT_AUTH_EMAIL_WORKER_ENABLED", "value": "false" },
            { "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "true" },
            { "name": "ENABLE_ORYX_BUILD", "value": "true" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2025-03-01",
      "name": "[concat(parameters('siteName'), '/scm')]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('siteName'))]"],
      "properties": { "allow": false }
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2025-03-01",
      "name": "[concat(parameters('siteName'), '/ftp')]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('siteName'))]"],
      "properties": { "allow": false }
    }
  ]
}
